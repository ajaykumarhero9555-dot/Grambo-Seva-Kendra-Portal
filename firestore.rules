rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function keepsStatus(field) {
      return request.resource.data[field] == resource.data[field]
        || (request.resource.data[field] != 'verified' && resource.data[field] != 'verified');
    }

    match /profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.id == uid
        && request.resource.data.account_status == 'active';
      allow update, delete: if isAdmin();
    }

    match /kyc_records/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.user_id == uid
        && request.resource.data.pan_status != 'verified'
        && request.resource.data.aadhaar_status != 'verified';
      allow update: if isAdmin()
        || (isOwner(uid) && keepsStatus('pan_status') && keepsStatus('aadhaar_status'));
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow create: if isAdmin()
        || (isOwner(adminId)
          && request.resource.data.uid == adminId
          && get(/databases/$(database)/documents/system/admin_bootstrap).data.claimed_by == adminId);
    }

    match /system/admin_bootstrap {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.claimed_by == request.auth.uid
        && request.resource.data.keys().hasOnly(['claimed_by', 'claimed_at']);
    }

    match /app_features/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /scheduled_feature_updates/{updateId} {
      allow read, write: if isAdmin();
    }

    match /portal_locks/{lockId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
